# Service ports (chosen to avoid conflict with NewsLens-AI on 8000/5173)
BACKEND_PORT=8001
FRONTEND_PORT=5174

# LLM provider: ollama, gemini, or groq
LLM_PROVIDER=ollama

# Ollama settings (default: gemma4:e4b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Gemini settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Chunking settings
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Storage paths
CHROMA_PERSIST_DIR=data/chroma
UPLOAD_DIR=data/uploads
