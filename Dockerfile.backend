# Dockerfile.backend — Fast uv-based image with live hot-reload support
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies (Tesseract OCR for scanned PDFs + curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Astral uv for 10x faster dependency resolution & caching (same as NewsLens-AI)
COPY --from=ghcr.io/astral-sh/uv:0.5.15 /uv /uvx /bin/

# Install Python dependencies first — cached unless requirements.txt changes
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --index-strategy unsafe-best-match -r requirements.txt

# Copy fallback application code (overridden in dev by live bind-mounts in docker-compose.yml)
COPY backend/ ./backend/
COPY core/ ./core/
COPY Sample_doc/ ./Sample_doc/

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8000/health || exit 1

# Watch backend/ and core/ for instant reload without rebuilding or restarting Docker
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/backend", "--reload-dir", "/app/core"]